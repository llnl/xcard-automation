  <rdf:Description rdf:about="http://example.org/llnl#supports_ai_usability">
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#datacard_capabilities"/>
    <rdfs:label>supports_ai_usability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
    <skos:definition>[required] Set to Yes if this data card includes the metadata to support AI usability of the dataset. Does not necessary indicate that the dataset itself is AI-usable, only that the data card includes some metadata to support AI usability.</skos:definition>
  </rdf:Description>
