  <rdf:Description rdf:about="http://example.org/llnl#reusability">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <skos:definition>[reusability_required] Information about the reusability of this dataset, such as license and rights, stewardship, data_quality, integrity, citation and stewardship information. --- License &amp; Rights ---------------------------------------------------- [reusability_if_applicable] Important: Required when release_status = Approved | Published. Use pending if not yet assigned. Includes information about the license governing use of the dataset, as well as any additional legal rights statements. NOTE ON LICENSES AND GOVERNANCE: A public/open license is not always the governing instrument for use, some controlled datasets may not have an SPDX-style reuse license at all, and use may instead be governed by contract, agreement, institutional review, or repository policy.</skos:definition>
    <bfo:BFO_0000101 rdf:resource="http://example.org/llnl#genesis_datacard_merged_shared"/>
    <rdfs:label>reusability</rdfs:label>
  </rdf:Description>
