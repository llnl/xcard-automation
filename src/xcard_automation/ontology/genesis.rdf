  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#change_log">
    <rdfs:subClassOf rdf:nodeID="N7717dda090d34e2b8f9fd0a49089ee79"/>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <rdfs:label>change_log</rdfs:label>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#datacard"/>
    <skos:definition>[discoverability_required] Running history of meaningful changes to this data card. Add a new entry every time the data card is updated. Do not overwrite or delete prior entries.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#source_marking_scheme">
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#sensitivity"/>
    <skos:definition>[discoverability_required] If this data card has a source marking, provide the marking scheme used. use vocabulary: DOE_CUI | DOE_UCNI | EO13526_Classified | AEA_RD_FRD_TFNI | DOD_CUI | DHS_CUI | Legacy_OUO | Legacy_Site_Specific | Other_Agency | None if a Legacy_OUO is unresolved to a current standard marking, normalized_control_basis should be populated as Legacy_Needs_Mapping to indicate that the control basis is legacy and needs interpretation for governance purposes.</skos:definition>
    <rdfs:label>source_marking_scheme</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <cco:ont00001982 rdf:resource="https://www.commoncoreontologies.org/ont00000649"/>
  </rdf:Description>
