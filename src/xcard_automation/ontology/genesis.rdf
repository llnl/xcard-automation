    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <rdfs:label>dataset_scale</rdfs:label>
    <cco:ont00001808 rdf:resource="http://purl.obolibrary.org/obo/IAO_IAO_0001000"/>
    <skos:definition>These fields describe the scale of the dataset, which is important for users to understand the scope and potential resource requirements for using the dataset. record_count and record_unit provide a standardized way to describe the number of primary records, samples, files, or other relevant units in the dataset, which is critical for understanding the dataset's size and complexity. compressed_bytes and uncompressed_bytes provide information about the storage requirements for the dataset, which is important for users to plan</skos:definition>
  </rdf:Description>
