    <rdfs:subClassOf rdf:nodeID="N78e0ddae13534032935d40cdbcb4ce4e"/>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000686"/>
    <skos:definition>[discoverability_required] Primary type of product type described by this data card. These align with and extend the STI Product Types to support interoperability with STI catalogs and OSTI DOE Data Explorer. Select the single best-fit: Technical_Report | Paper_or_Proceedings | Journal_Article | Software_Manual | Data | Collection | Computer_Related | Model | Agent Data is expected here for a data card describing a dataset, but select the best fit if this data card describes a different type of product.</skos:definition>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#discoverability"/>
    <rdfs:label>product_type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#overall_sensitivity">
    <skos:definition>[discoverability_required] The overall sensitivity of THE DATA CARD only. Set based solely on the sensitivity of this data card. not the dataset it describes. See NOTE ON SENSITIVITY above. The sensitivity of the data card and the dataset are independent and will often differ. Uses a controlled vocabulary: - Public: No sensitivity; publicly shareable. - Unclassified_Uncontrolled: Unclassified but uncontrolled; may have minimal sensitivity; generally shareable with minimal controls. - CUI: CUI (Controlled Unclassified Information); requires handling per CUI guidelines; access controls required. - UCNI: UCNI (Unclassified Controlled Nuclear Information); requires handling per UCNI guidelines; strict access controls required. - Classified: Classified information; requires handling per classification level and guide; strict access controls required. - Legacy_Controlled: Legacy controlled information; may have specific handling requirements based on legacy controls; access controls required. - Mixed: Mixed sensitivity; contains a combination of sensitive and non-sensitive information; handling requirements depend on the specific content; access controls required. - Other_Controlled: Other controlled information; may have specific handling requirements based on other controls; access controls required.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
    <rdfs:label>overall_sensitivity</rdfs:label>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#sensitivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#osti_elink2_metadata_compliant">
    <rdfs:label>osti_elink2_metadata_compliant</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000686"/>
    <skos:definition>[governed_use_required] select one from list: Yes | No | Unknown — metadata complies with OSTI E-Link 2 API specs</skos:definition>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#compliance"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#object_type">
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#tags"/>
    <skos:definition>select one of: Dataset | Model | Software | AI_Agent | Eval | Framework | Software</skos:definition>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <rdfs:label>object_type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#task_category">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <rdfs:subClassOf rdf:nodeID="N09ebe6bbc2b44d9f9f28c3e85d3474e0"/>
    <skos:definition>[discoverability_if_applicable, at least one value required if task_subcategory is present] Primary ML task category or categories for this dataset. Populate for AI-ready data; helps ML practitioners find relevant datasets in the catalog. e.g., classification | regression | segmentation | detection | generation | translation | summarization | ranking | anomaly_detection | clustering | reinforcement_learning | other</skos:definition>
    <rdfs:label>task_category</rdfs:label>
    <cco:ont00001982 rdf:resource="http://example.org/llnl#task_subcategory"/>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#dataset_description"/>
  </rdf:Description>
