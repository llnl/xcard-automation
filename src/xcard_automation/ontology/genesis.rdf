  <rdf:Description rdf:about="http://example.org/llnl#software">
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#creator"/>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#related_resources"/>
    <cco:ont00001808 rdf:resource="https://www.commoncoreontologies.org/ont00001261"/>
    <rdfs:label>software</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <skos:definition>- name: __NAME__ version: __VERSION__ identifier: type: __TYPE__                      # doi | ark | handle | url | local | other value: __VALUE__ role: - ${ROLE}                           # [interoperability_if_applicable] list from roles extending the CRediT taxonomy: Conceptualization | Data_Curation | Formal_Analysis | Funding_Acquisition | Investigation | Methodology | Project_Administration | Resources | Software | Supervision | Validation | Visualization | Writing_Original_Draft | Writing_Review_Editing | Data_Collection | Other relationship: __REL__                 # see vocabulary above</skos:definition>
  </rdf:Description>
