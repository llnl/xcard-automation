  <rdf:Description rdf:about="http://example.org/llnl#ai_models">
    <skos:definition>- name: __NAME__ version: __VERSION__ accessed_date: __YYYY-MM-DD__ identifier: type: __TYPE__                      # doi | ark | handle | url | local | other value: __VALUE__ role: - ${ROLE}                           # [interoperability_if_applicable] list from roles extending the CRediT taxonomy: Conceptualization | Data_Curation | Formal_Analysis | Funding_Acquisition | Investigation | Methodology | Project_Administration | Resources | Software | Supervision | Validation | Visualization | Writing_Original_Draft | Writing_Review_Editing | Data_Collection | Other relationship: __REL__                 # see vocabulary above</skos:definition>
