  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb3fff7ddd63441d4b5880717a563605f">
    <owl:onProperty rdf:resource="http://example.org/llnl#value"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#state">
    <rdfs:label>state</rdfs:label>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#workflow"/>
    <skos:definition>[discoverability_required] Current lifecycle position: Raw        — data as collected; no processing applied Processing — actively being cleaned, transformed, or reduced QA         — undergoing quality assurance or validation Analysis   — in active scientific analysis Review     — under formal review (security, export, IRB, etc.) Embargo    — complete but intentionally withheld from release Published  — publicly released Archived   — preserved; no longer actively maintained not_applicable - use when workflow state is not applicable or not yet determined</skos:definition>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#code">
    <skos:definition>code for missing data</skos:definition>
    <cco:ont00001982 rdf:resource="https://www.commoncoreontologies.org/ont00000077"/>
    <rdfs:subClassOf rdf:nodeID="N0617ca8a3e4d4339a27f31905bf479fa"/>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#missing_data_codes"/>
    <rdfs:label>code</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#genesis_datacard_merged_shared">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000253"/>
    <skos:definition>&lt;INSTRUCTIONS: Considerations for filling out the data card: Deciding the appropriate resolution for documenting a scientific dataset in a data card can be complex. Data cards may describe single or multiple data files, datasets, or versions. Too granular, and there will be too many data cards; too broad, and details may be lost. Consider the use, audience, and documentation the data card needs to provide to maintain transparency without duplication. Reflect on these relationships to balance clarity, usability, and sustainability.&gt;</skos:definition>
    <rdfs:label>genesis_datacard_merged_shared</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#intended_partner_classes">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000686"/>
    <rdfs:label>intended_partner_classes</rdfs:label>
    <skos:definition>[accessibility_if_applicable] List of intended partner classes or user groups for this dataset, if any. from controlled vocabulary: Internal_Team | Tri_Lab | DOE_NNSA_Lab | Federal_Partner | Contractor | Academic_Researchers | External_Research_Partner | Public | Industry_Partner | Other If absent, or null, this field is not yet known or determined. Use an empty list if definitively no specific partner classes are targeted. Use public if this dataset is intended for broad public use without restrictions.</skos:definition>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#access_policy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#dates">
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#interoperability"/>
    <rdfs:label>dates</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <skos:definition>field regarding data collection dates</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#author">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <skos:definition>[reusability_if_applicable, required if preferred_citation is included] e.g., Smith, John A.; Doe, Jane B.</skos:definition>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#preferred_citation"/>
    <rdfs:label>author</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#pii_status">
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#privacy"/>
    <rdfs:label>pii_status</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000686"/>
    <skos:definition>[governed_use_required] select one from list: Yes | No | Pending_Review | Unknown</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#inference_use_conditions">
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#ai_usage"/>
    <rdfs:label>inference_use_conditions</rdfs:label>
    <skos:definition>[ai_usability_if_applicable, required if inference_use_status is Conditional] e.g., Only for non-commercial research | Requires citation of SAND2024-XXXXX</skos:definition>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <rdfs:subClassOf rdf:nodeID="Nd685f75000e64611a060e08f1e71f23a"/>
  </rdf:Description>
