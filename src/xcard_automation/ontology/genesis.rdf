    <rdfs:subClassOf rdf:nodeID="Nd01be64e01ae4b38a3caf54133386b00"/>
    <skos:definition>[discoverability_if_applicable] Additional contacts (e.g., instrument PI, data steward). Same structure as contact above: contact_details: - type: person | organization person: given_name: __GIVEN_NAME__ family_name: __FAMILY_NAME__ orcid: __ORCID__ # Required where DOE employee/contractor author policy applies, if locally applicable email: __EMAIL__ affiliation: name: __ORG_NAME__ ror_id: __ROR_ID__ valid_until: __YYYY-MM-DD__ succession_note: __NOTE__</skos:definition>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#discoverability"/>
    <rdfs:label>additional_contacts</rdfs:label>
  </rdf:Description>
