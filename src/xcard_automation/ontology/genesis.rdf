    <rdfs:label>howpublished</rdfs:label>
    <cco:ont00001982 rdf:resource="http://purl.obolibrary.org/obo/IAO_IAO_0000444"/>
    <skos:definition>[reusability_if_applicable, either preferred_citation or howpublished is required] e.g., (Version v1) [Data set]. Zenodo | Available at https://doi.org/10.1234/zenodo.1234567</skos:definition>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#preferred_citation"/>
  </rdf:Description>
