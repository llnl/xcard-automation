    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000649"/>
    <rdfs:subClassOf rdf:nodeID="Ne3b2ed78249243e7bed56c80f609017d"/>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#license"/>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#preferred_citation"/>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#additional_licenses"/>
    <skos:definition>[reusability_if_applicable] URL to license text or LICENSE.md for repo-local file</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#review_provenance_companion">
    <skos:definition>Optional companion block for review/provenance data that the team has indicated should exist somewhere in the broader card/model. This block extends the Genesis Sensitivity V2 review_provenance_companion (which only accepts a single review) by allowing multiple review records to be captured in a structured format, which is especially useful for datasets that have undergone multiple reviews or have complex provenance histories.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <rdfs:label>review_provenance_companion</rdfs:label>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#governed_use"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/llnl#compliance">
