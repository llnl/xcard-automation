    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <rdfs:subClassOf rdf:nodeID="N39f0ac4dc694456cabe1d44966e9762e"/>
    <bfo:BFO_0000176 rdf:resource="http://example.org/llnl#data_structure"/>
    <skos:definition>[interoperability_required] Primary variables, fields, or features. IMPORTANT: choose ONE form and use it consistently — do not mix. For basic documentation — flat string list: - name: temperature - name: pressure - name: timestamp - name: label To support  AI-ready data — structured form (replace flat list above): - name: temperature: data_type: float           # float | int | string | boolean | datetime | other unit: Kelvin description: Sample temperature at time of measurement range: 273.15 - 373.15</skos:definition>
  </rdf:Description>
