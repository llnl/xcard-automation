llnl:Issued a sh:NodeShape ;
    rdfs:label "issued" ;
    rdfs:comment "[interoperability_if_applicable] ISO 8601 date the dataset was first publicly released" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Dates ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Issued .

llnl:Keywords a sh:NodeShape ;
    rdfs:label "keywords" ;
    rdfs:comment "[discoverability_required] Terms that describe this dataset and aid discovery. Include domain terms, methods, instruments, and relevant ontology terms." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:DatasetDescription ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Keywords .

llnl:KnownContractualRights a sh:NodeShape ;
    rdfs:label "known_contractual_rights" ;
    rdfs:comment "[reusability_if_applicable] Legal rights statement, separate from license. Important because DOE/NNSA datasets may have complex contractual arrangements that impact how the data can be used and shared beyond license terms. e.g., Government has unlimited rights" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class terms:RightsStatement ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001982 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path llnl:value ],
        [ sh:class llnl:AdditionalLicenses ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:KnownContractualRights .

llnl:KnownIssues a sh:NodeShape ;
    rdfs:label "known_issues" ;
    rdfs:comment "[reusability_required] e.g., Sensor drift observed after 2023-06-01T12:00:00Z" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path llnl:value ],
        [ sh:class pato:PATO_0000069 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001808 ],
        [ sh:class llnl:DataQuality ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:KnownIssues .

llnl:Language a sh:NodeShape ;
    rdfs:label "language" ;
    rdfs:comment "[discoverability_required] ISO 639-1 language code for this data card's content" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:DataStructure ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Language .

llnl:LastAccessed a sh:NodeShape ;
    rdfs:label "last_accessed" ;
    rdfs:comment "Date of last access" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:UsageMetrics ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:LastAccessed .

llnl:LegacyLabelSource a sh:NodeShape ;
    rdfs:label "legacy_label_source" ;
    rdfs:comment "[discoverability_if_applicable]  Preserves deprecated or local historical control labels such as OUO, SBU, if source_marking_scheme = Legacy_OUO, legacy_label_source should be populated or site-specific legacy markings as provenance/source information only. Provide as a list of unique entries if multiple legacy labels apply. E.g., - OUO - SBU" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:LegacyLabelSource .

llnl:Level a sh:NodeShape ;
    rdfs:label "level" ;
    rdfs:comment "[reusability_if_applicable] Select one: Project_Managed | Repository_Managed | Externally_Managed | not_applicable" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "Project_Managed" "Repository_Managed" "Externally_Managed" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path llnl:value ],
        [ sh:class llnl:Stewardship ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class terms:ProvenanceStatement ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001916 ] ;
    sh:targetClass llnl:Level .

llnl:License a sh:NodeShape ;
    rdfs:label "license" ;
    rdfs:comment "A public/open license is not always the governing instrument for use, some controlled datasets may not have an SPDX-style reuse license at all, and use may instead be governed by contract, agreement, institutional review, or repository policy." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Reusability ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class terms:LicenseDocument ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001982 ] ;
    sh:targetClass llnl:License .

llnl:Limitations a sh:NodeShape ;
    rdfs:label "limitations" ;
    rdfs:comment "[discoverability_if_applicable] Known limitations, gaps, or caveats users should be aware of before using this dataset." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:DatasetDescription ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:Limitations .

llnl:Location a sh:NodeShape ;
    rdfs:label "location" ;
    rdfs:comment "[discoverability_if_applicable] Point location for facility-based experimental data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Facilities ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Location .

llnl:Maintainer a sh:NodeShape ;
    rdfs:label "maintainer" ;
    rdfs:comment "[reusability_if_applicable] Person or organization responsible for ongoing maintenance." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Stewardship ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class cco:ont00001017 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001982 ] ;
    sh:targetClass llnl:Maintainer .

llnl:Modalities a sh:NodeShape ;
    rdfs:label "modalities" ;
    rdfs:comment "[interoperability_required] Data modalities present. e.g., [tabular, image, time-series, text, graph, point-cloud]" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:DataStructure ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:Modalities .

llnl:Modified a sh:NodeShape ;
    rdfs:label "modified" ;
    rdfs:comment "[interoperability_if_applicable] ISO 8601 date of most recent significant modification" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Dates ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:Modified .

llnl:NeedToKnowBasis a sh:NodeShape ;
    rdfs:label "need_to_know_basis" ;
    rdfs:comment "[governed_use_if_applicable] If access is restricted based on a need-to-know basis, list the specific basis for the restriction. select one from list: Mission_Need | Job_Duty | Project_Program_Association | Agreement_Defined | DGB_Exception_Waiver" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "Mission_Need" "Job_Duty" "Project_Program_Association" "Agreement_Defined" "DGB_Exception_Waiver" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:UseGovernance ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:NeedToKnowBasis .

llnl:NoiseCharacteristics a sh:NodeShape ;
    rdfs:label "noise_characteristics" ;
    rdfs:comment "[reusability_if_applicable]" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:DataQuality ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:NoiseCharacteristics .

llnl:NormalizedControlBasis a sh:NodeShape ;
    rdfs:label "normalized_control_basis" ;
    rdfs:comment "[discoverability_if_applicable] Optional interpreted control basis used for governance where source materials This does not replace authoritative source markings. Provide as a list of unique entries if multiple control bases apply. If source_marking_scheme = Legacy_OUO and the legacy marking is unresolved to a current standard marking, this should be populated as Legacy_Needs_Mapping to indicate that the control basis is legacy and needs interpretation for governance purposes. Entries should use this controlled vocabulary: - Classified - CUI - UCNI - Public_Release_Approved - Legacy_Needs_Mapping - Other_Controlled" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:NormalizedControlBasis .

llnl:NorthBoundLatitude a sh:NodeShape ;
    rdfs:label "northBoundLatitude" ;
    rdfs:comment "aligns with datacite:northBoundLatitude" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class cco:ont00000469 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001808 ],
        [ sh:class unit:DEG ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path qudt:hasUnit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path llnl:value ],
        [ sh:class llnl:GeoLocationBox ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:NorthBoundLatitude .

llnl:Note a sh:NodeShape ;
    rdfs:label "note" ;
    rdfs:comment "[reusability_if_applicable] e.g., Available at \\url{ark:/12345/abcde} For legacy bibtex entries (that don't accept eprinttype and eprint) and that need to support an ark or other identifiers that don't fit cleanly into the existing fields, the note field can be used to capture this information in a free-text format. include a note: field use this format for the note field: note: Available at \\url{ark:/12345/abcde} --- Integrity & Fixity ----------------------------------------- [reusability_if_applicable] Checksums enable automated validation of data integrity after transfer or storage." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:PreferredCitation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path cco:ont00001920 ] ;
    sh:targetClass llnl:Note .

llnl:Notes a sh:NodeShape ;
    rdfs:label "notes" ;
    rdfs:comment "[interoperability_if_applicable] Additional environment details, key library versions, or reference to a full environment manifest. e.g., See requirements.txt in dataset root e.g., numpy 1.24, pytorch 2.0.1, h5py 3.8.0" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:SoftwareEnvironment ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Notes .

llnl:ObjectType a sh:NodeShape ;
    rdfs:label "object_type" ;
    rdfs:comment "select one of: Dataset | Model | Software | AI_Agent | Eval | Framework | Software" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Tags ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "Dataset" "Model" "Software" "AI_Agent" "Eval" "Framework" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:ObjectType .

llnl:Orcid a sh:NodeShape ;
    rdfs:label "orcid" ;
    rdfs:comment "[discoverability_if_applicable] Format: https://orcid.org/0000-0000-0000-0000 Required where DOE employee/contractor author policy applies, if locally applicable Register at https://orcid.org if needed" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:Orcid .

llnl:Organization a sh:NodeShape ;
    rdfs:label "organization" ;
    rdfs:comment "use when a team or org created the data card without a named individual" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class cco:ont00001261 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001808 ],
        [ sh:class llnl:Contributors ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Organization .

llnl:Os a sh:NodeShape ;
    rdfs:label "os" ;
    rdfs:comment "[interoperability_if_applicable] e.g., RHEL 8.6 | Ubuntu 22.04" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:SoftwareEnvironment ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class swo:SWO_0000021 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001808 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:Os .

llnl:OstiElink2MetadataCompliant a sh:NodeShape ;
    rdfs:label "osti_elink2_metadata_compliant" ;
    rdfs:comment "[governed_use_required] select one from list: Yes | No | Unknown — metadata complies with OSTI E-Link 2 API specs" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "Yes" "No" "Unk" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Compliance ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:OstiElink2MetadataCompliant .

llnl:OutOfScopeUse a sh:NodeShape ;
    rdfs:label "out_of_scope_use" ;
    rdfs:comment "[governed_use_if_applicable] Uses this dataset should NOT be applied to. e.g., clinical decision-making | real-time control systems" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:UseGovernance ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:OutOfScopeUse .

llnl:OverallSensitivity a sh:NodeShape ;
    rdfs:label "overall_sensitivity" ;
    rdfs:comment "[discoverability_required] The overall sensitivity of THE DATA CARD only. Set based solely on the sensitivity of this data card. not the dataset it describes. See NOTE ON SENSITIVITY above. The sensitivity of the data card and the dataset are independent and will often differ. Uses a controlled vocabulary: - Public: No sensitivity; publicly shareable. - Unclassified_Uncontrolled: Unclassified but uncontrolled; may have minimal sensitivity; generally shareable with minimal controls. - CUI: CUI (Controlled Unclassified Information); requires handling per CUI guidelines; access controls required. - UCNI: UCNI (Unclassified Controlled Nuclear Information); requires handling per UCNI guidelines; strict access controls required. - Classified: Classified information; requires handling per classification level and guide; strict access controls required. - Legacy_Controlled: Legacy controlled information; may have specific handling requirements based on legacy controls; access controls required. - Mixed: Mixed sensitivity; contains a combination of sensitive and non-sensitive information; handling requirements depend on the specific content; access controls required. - Other_Controlled: Other controlled information; may have specific handling requirements based on other controls; access controls required." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "Public" "Unclassified_uncontrolled" "CUI" "UCNI" "Classified" "Legacy_Controlled" "Mixed" "Other_Controlled" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:OverallSensitivity .

llnl:PermittedUse a sh:NodeShape ;
    rdfs:label "permitted_use" ;
    rdfs:comment "[governed_use_if_applicable] Uses this dataset is suitable for, beyond the intended use. e.g., exploratory analysis | hypothesis generation | educational use" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:UseGovernance ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:PermittedUse .

llnl:PhiStatus a sh:NodeShape ;
    rdfs:label "phi_status" ;
    rdfs:comment "[governed_use_required] select one from list: Yes | No | Pending_Review | Unknown" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Privacy ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "Yes" "No" "Pending Review" "Unknown" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:PhiStatus .

llnl:PiiStatus a sh:NodeShape ;
    rdfs:label "pii_status" ;
    rdfs:comment "[governed_use_required] select one from list: Yes | No | Pending_Review | Unknown" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Privacy ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "Yes" "No" "Pending Review" "Unknown" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:PiiStatus .

llnl:PipelineStage a sh:NodeShape ;
    rdfs:label "pipeline_stage" ;
    rdfs:comment "[discoverability_if_applicable] Freetext position in processing pipeline. e.g., post-detector, pre-reconstruction e.g., raw telemetry, pre-calibration" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Workflow ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:PipelineStage .

llnl:PolicyText a sh:NodeShape ;
    rdfs:label "policy_text" ;
    rdfs:comment "[accessibility_if_applicable] Inline summary if no policy_url exists" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:AccessPolicy ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:PolicyText .

llnl:PolicyUrl a sh:NodeShape ;
    rdfs:label "policy_url" ;
    rdfs:comment "[accessibility_if_applicable] URL to the full access policy document" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:AccessPolicy ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:PolicyUrl .

llnl:PopulatedByRepository a sh:NodeShape ;
    rdfs:label "populated_by_repository" ;
    rdfs:comment "[reference_only_do_not_include] Always true; signals to parsers this block is system-owned" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
