llnl:SourceMarkingScheme a sh:NodeShape ;
    rdfs:label "source_marking_scheme" ;
    rdfs:comment "[discoverability_required] If this data card has a source marking, provide the marking scheme used. use vocabulary: DOE_CUI | DOE_UCNI | EO13526_Classified | AEA_RD_FRD_TFNI | DOD_CUI | DHS_CUI | Legacy_OUO | Legacy_Site_Specific | Other_Agency | None if a Legacy_OUO is unresolved to a current standard marking, normalized_control_basis should be populated as Legacy_Needs_Mapping to indicate that the control basis is legacy and needs interpretation for governance purposes." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "DOE_CUI" "DOE_UCNI" "EO13526_Classified" "AEA_RD_FRD_TFNI" "DOD_CUI" "DHS_CUI" "Legacy_OUO" "Legacy_Site_Specific" "Other_Agency" "None" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path llnl:value ],
        [ sh:class cco:ont00000649 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001982 ],
        [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:SourceMarkingScheme .

llnl:SourceMarkingString a sh:NodeShape ;
    rdfs:label "source_marking_string" ;
    rdfs:comment "[discoverability_required] If this data card has a source marking, provide the marking string exactly as it appears on the data card." ;
