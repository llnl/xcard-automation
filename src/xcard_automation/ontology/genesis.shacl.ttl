@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cros: <http://www.semanticweb.org/cao/ontologies/CROS#> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix iof-core: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix llnl: <http://example.org/llnl#> .
@prefix mseo: <https://purl.matolab.org/mseo/mid/> .
@prefix obi: <http://purl.obolibrary.org/obo/OBI_> .
@prefix pato: <http://purl.obolibrary.org/obo/PATO_> .
@prefix pmdco: <https://w3id.org/pmd/co/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix swo: <http://www.ebi.ac.uk/swo/> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

llnl:AccessLevel a sh:NodeShape ;
    rdfs:label "access_level" ;
    rdfs:comment "[accessibility_required] Open | Restricted | Controlled" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "Open" "Restricted" "Controlled" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Name ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:AccessLevel .

llnl:AccessProtocol a sh:NodeShape ;
    rdfs:label "access_protocol" ;
    rdfs:comment "[reference_only_do_not_include] https | ftp | s3 | globus | nfs | lustre | other" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "https" "ftp" "s3" "globus" "nfs" "lustre" "other" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path llnl:value ],
        [ sh:class llnl:Name ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class llnl:Repositories ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001982 ] ;
    sh:targetClass llnl:AccessProtocol .

llnl:AccessRestrictions a sh:NodeShape ;
    rdfs:label "access_restrictions" ;
    rdfs:comment "[accessibility_if_applicable] Freetext description of access restrictions. e.g., Requires signed DUA | None - publicly accessible" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:AccessPolicy ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:AccessRestrictions .

llnl:AccessedDate a sh:NodeShape ;
    rdfs:label "accessed_date" ;
    rdfs:comment "Date when AI model was accessed" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:AiModel ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:AccessedDate .

llnl:AdditionalIds a sh:NodeShape ;
    rdfs:label "additional_ids" ;
    rdfs:comment "[discoverability_if_applicable] Additional identifiers for this dataset. Aligns with adms:identifier and can include secondary identifiers, legacy identifiers, or identifiers for specific versions if primary_id is a collection-level identifier." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Identification ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:AdditionalIds .

llnl:Affiliation a sh:NodeShape ;
    rdfs:label "affiliation" ;
    rdfs:comment "The agent where the human contributor is part of" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class cco:ont00000591 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001808 ] ;
    sh:targetClass llnl:Affiliation .

llnl:AgentType a sh:NodeShape ;
    rdfs:label "agent_type" ;
    rdfs:comment "[discoverability_required] person | organization | ai_model | software TYPE: person — use for a human contributor" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:AdditionalContacts ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:AgentType .

llnl:AgreementRequired a sh:NodeShape ;
    rdfs:label "agreement_required" ;
    rdfs:comment "[governed_use_required] select one from list: Yes | No — Is a rights release agreement required for use of this dataset?" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:RightsReleaseRecords ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:AgreementRequired .

llnl:AgreementType a sh:NodeShape ;
    rdfs:label "agreement_type" ;
    rdfs:comment "[governed_use_if_applicable, required if agreement_required = Yes] list all that apply: DUA | CRADA | MOU | NDA | LICENSE | WFO | OTHER" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "DUA" "CRADA" "MOU" "NDA" "LICENSE" "WFO" "OTHER" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:RightsReleaseRecords ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:AgreementType .

llnl:AiModels a sh:NodeShape ;
    rdfs:label "ai_models" ;
    rdfs:comment "- name: __NAME__ version: __VERSION__ accessed_date: __YYYY-MM-DD__ identifier: type: __TYPE__                      # doi | ark | handle | url | local | other value: __VALUE__ role: - ${ROLE}                           # [interoperability_if_applicable] list from roles extending the CRediT taxonomy: Conceptualization | Data_Curation | Formal_Analysis | Funding_Acquisition | Investigation | Methodology | Project_Administration | Resources | Software | Supervision | Validation | Visualization | Writing_Original_Draft | Writing_Review_Editing | Data_Collection | Other relationship: __REL__                 # see vocabulary above" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:RelatedResources ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class cco:ont00000653 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001982 ] ;
    sh:targetClass llnl:AiModels .

llnl:ApprovedEnvironments a sh:NodeShape ;
    rdfs:label "approved_environments" ;
    rdfs:comment "[accessibility_if_applicable] Describe the approved environment for access. List of approved environments, if more than one — e.g., DOE HPC facilities with export control review | On-site access only at Oak Ridge National Laboratory [] means no explicitly approved environments; access may still be granted on a case-by-case basis. null or absent means it has not yet been determined whether approved environments are required." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:AccessPolicy ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:ApprovedEnvironments .

llnl:Authentication a sh:NodeShape ;
    rdfs:label "authentication" ;
    rdfs:comment "None | API_Key | OAuth2 | SAML | Certificate | OpenID_Connect | Basic_Auth | Bearer_Token | Other" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:IntendedRepositories ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001808 ],
        [ sh:in ( "None" "API_Key" "OAuth2" "SAML" "Certificate" "OpenID_Connect" "Basic_Auth" "Bearer_Token" "Other" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path llnl:value ],
        [ sh:class llnl:Name ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Authentication .

llnl:Author a sh:NodeShape ;
    rdfs:label "author" ;
    rdfs:comment "[reusability_if_applicable, required if preferred_citation is included] e.g., Smith, John A.; Doe, Jane B." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:PreferredCitation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Author .

llnl:AuthorizationRequired a sh:NodeShape ;
    rdfs:label "authorization_required" ;
    rdfs:comment "[accessibility_if_applicable] Required if access_level is not open. List of authorization needed to access this dataset: Account               — registered account required User_Agreement        — user agreement or terms of service Data_Use_Agreement    — formal DUA required Sponsor_Approval      — sponsor or PI approval required Export_Control_Review — export control review required IRB_Approval          — IRB approval required Other                 — describe in access_restrictions" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:AccessPolicy ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:AuthorizationRequired .

llnl:Authors a sh:NodeShape ;
    rdfs:label "authors" ;
    rdfs:comment "[discoverability_required]" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Discoverability ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Authors .

llnl:AwardNumber a sh:NodeShape ;
    rdfs:label "award_number" ;
    rdfs:comment "[discoverability_if_applicable] e.g., DE-AC05-00OR22725" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Name ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:AwardNumber .

llnl:BiasRisks a sh:NodeShape ;
    rdfs:label "bias_risks" ;
    rdfs:comment "[ai_usability_required] e.g., Overrepresents samples from facility X | None" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:AiUsage ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:BiasRisks .

llnl:ChecksumAvailable a sh:NodeShape ;
    rdfs:label "checksum_available" ;
    rdfs:comment "[reusability_if_applicable] Yes | No" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Integrity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:ChecksumAvailable .

llnl:ChecksumType a sh:NodeShape ;
    rdfs:label "checksum_type" ;
    rdfs:comment "[required if checksum_available=Yes] sha256 | sha512 | md5 | other sha256 recommended; md5 not recommended for new datasets" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "sha256" "sha512" "md5" "other" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Integrity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:ChecksumType .

llnl:ChecksumValue a sh:NodeShape ;
    rdfs:label "checksum_value" ;
    rdfs:comment "[required if checksum_available=Yes] Checksum of primary data file(s). For multi-file datasets, provide a checksum manifest and link here." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Integrity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:ChecksumValue .

llnl:CitationCount a sh:NodeShape ;
    rdfs:label "citation_count" ;
    rdfs:comment "Field for citation counts" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class iao:IAO_0000301 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001808 ],
        [ sh:class llnl:UsageMetrics ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:CitationCount .

llnl:ClassificationCategory a sh:NodeShape ;
    rdfs:label "classification_category" ;
    rdfs:comment "[discoverability_if_applicable] For classified information, list the classification category or categories, if applicable. use vocabulary: NSI | RD | FRD | TFNI | Other_Classified" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class cco:ont00000751 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001942 ],
        [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "NSI" "RD" "FRD" "TFNI" "Other_Classified" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:ClassificationCategory .

llnl:ClassificationLevel a sh:NodeShape ;
    rdfs:label "classification_level" ;
    rdfs:comment "[discoverability_if_applicable] For classified information, top_secret | secret | confidential classification level" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class cco:ont00000751 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001942 ],
        [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "classified information" "top_secret" "secret" "confidential" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:ClassificationLevel .

llnl:ClassifiedControlMarkings a sh:NodeShape ;
    rdfs:label "classified_control_markings" ;
    rdfs:comment "[discoverability_if_applicable] For classified information, list the specific control markings that apply, if any. Provide as a list of unique entries if multiple markings apply. e.g., - NOFORN - CNWDI - SIGMA 14 - REL TO USA, CAN, GBR - ORCON" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class cco:ont00000751 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001942 ],
        [ sh:in ( "NOFORN" "CNWDI" "SIGMA 14" "REL TO USA, CAN, GBR" "ORCON" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:ClassifiedControlMarkings .

llnl:ClassifiedStatus a sh:NodeShape ;
    rdfs:label "classified_status" ;
    rdfs:comment "[discoverability_required] Yes | No description: Indicates whether the asset is classified." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class cco:ont00000751 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001942 ],
        [ sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:ClassifiedStatus .

llnl:Code a sh:NodeShape ;
    rdfs:label "code" ;
    rdfs:comment "code for missing data" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:MissingDataCodes ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class cco:ont00000077 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001982 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:Code .

llnl:CollectionMethodology a sh:NodeShape ;
    rdfs:label "collection_methodology" ;
    rdfs:comment "[discoverability_if_applicable] How was data acquired? e.g., experimental sensors | computational simulation | human annotation | derived from prior datasets" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "sensors" "computational simulation" "human annotation" "derived from prior datasets" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path llnl:value ],
        [ sh:class iao:IAO_0001000 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001808 ],
        [ sh:class llnl:DatasetDescription ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:CollectionMethodology .

llnl:Comments a sh:NodeShape ;
    rdfs:label "comments" ;
    rdfs:comment "[governed_use_if_applicable]" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:SourceReviewReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Comments .

llnl:Compiler a sh:NodeShape ;
    rdfs:label "compiler" ;
    rdfs:comment "[interoperability_if_applicable] e.g., GCC 11.3 | Intel oneAPI 2023.1" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class cco:ont00000932 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001808 ],
        [ sh:class llnl:SoftwareEnvironment ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:Compiler .

llnl:Completeness a sh:NodeShape ;
    rdfs:label "completeness" ;
    rdfs:comment "[reusability_required] e.g., All detector channels present; 2% of timesteps missing due to instrument downtime on 2023-04-12" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:DataQuality ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path llnl:value ],
        [ sh:class cco:ont00000575 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001982 ] ;
    sh:targetClass llnl:Completeness .

llnl:CompletenessScore a sh:NodeShape ;
    rdfs:label "completeness_score" ;
    rdfs:comment "[reference_only_do_not_include] Catalog-computed completeness score against completeness of fields in declared inteded_capabilities" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Repository ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:CompletenessScore .

llnl:CompressedBytes a sh:NodeShape ;
    rdfs:label "compressed_bytes" ;
    rdfs:comment "[accessibility_if_applicable] Total size when compressed, in bytes" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class unit:BYTE ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path qudt:hasUnit ],
        [ sh:class llnl:DatasetScale ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
