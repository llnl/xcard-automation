llnl:TrainingUseConditions a sh:NodeShape ;
    rdfs:label "training_use_conditions" ;
    rdfs:comment "[ai_usability_if_applicable, required if training_use_status is Conditional] e.g., Only for non-commercial research | Requires citation of SAND2024-XXXXX" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
