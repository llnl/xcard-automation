llnl:ScienceDomain a sh:NodeShape ;
    rdfs:label "science_domain" ;
    rdfs:comment "[discoverability_if_applicable] Extends the the list of OSTI Subject Areas with an Other category for datasets that do not fit into the OSTI list. Controlled vocabulary: Biology and Medicine | Chemistry | Energy Storage, Conversion, and Utilization | Engineering | Environmental Sciences | Fission and Nuclear Technologies | Fossil Fuels | Geosciences | Materials | Mathematics and Computing | National Defense | Physics | Power Generation and Distribution | Renewable Energy | Other" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Name ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001920 ],
        [ sh:class llnl:DatasetDescription ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "Biology and Medicine" "Chemistry" "Energy Storage, Conversion, and Utilization" "Engineering" "Environmental Sciences" "Fission and Nuclear Technologies" "Fossil Fuels" "Geosciences" "Materials" "Mathematics and Computing" "National Defense" "Physics" "Power Generation and Distribution" "Renewable Energy" "Other" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:ScienceDomain .

llnl:SemanticContext a sh:NodeShape ;
    rdfs:label "semantic_context" ;
    rdfs:comment "[interoperability_if_applicable] Semantic conventions applied. e.g., NetCDF CF Conventions 1.10 | NeXus NXmonopd" ;
