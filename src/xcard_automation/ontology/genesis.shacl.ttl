            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:SupportsInteroperability .

llnl:SupportsReusability a sh:NodeShape ;
    rdfs:label "supports_reusability" ;
    rdfs:comment "[required] Set to Yes if this data card includes the metadata to support reusability of the dataset. Does not necessary indicate that the dataset itself is reusable, only that the data card includes some metadata to support reusability." ;
