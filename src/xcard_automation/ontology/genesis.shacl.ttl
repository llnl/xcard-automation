        [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class cco:ont00000649 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001982 ] ;
    sh:targetClass llnl:SourceMarkingString .

llnl:SourceReviewAuthority a sh:NodeShape ;
