            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Supersedes .

llnl:SupportsAccessibility a sh:NodeShape ;
    rdfs:label "supports_accessibility" ;
    rdfs:comment "[required] Set to Yes if this data card includes the metadata to support accessibility of the dataset. Required for data cards describing datasets that are shared or published. Does not necessary indicate that the dataset itself is accessible, only that the data card includes all the metadata to support accessibility." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:DatacardCapabilities ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:SupportsAccessibility .

llnl:SupportsAiUsability a sh:NodeShape ;
    rdfs:label "supports_ai_usability" ;
    rdfs:comment "[required] Set to Yes if this data card includes the metadata to support AI usability of the dataset. Does not necessary indicate that the dataset itself is AI-usable, only that the data card includes some metadata to support AI usability." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:DatacardCapabilities ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:SupportsAiUsability .

llnl:SupportsDiscoverability a sh:NodeShape ;
    rdfs:label "supports_discoverability" ;
    rdfs:comment "[required] Yes is required as all data cards must support basic discovery and identification of the dataset. Yes is required for all data cards." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:DatacardCapabilities ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:SupportsDiscoverability .

llnl:SupportsGovernedUse a sh:NodeShape ;
    rdfs:label "supports_governed_use" ;
    rdfs:comment "[required] Set to Yes if this data card includes the metadata to support governed use of the dataset. Does not necessary indicate that the dataset itself is cleared for governed use, only that the data card includes some metadata to support governed use." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:DatacardCapabilities ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:SupportsGovernedUse .

llnl:SupportsInteroperability a sh:NodeShape ;
    rdfs:label "supports_interoperability" ;
    rdfs:comment "[required] Set to Yes if this data card includes the metadata to support interoperability of the dataset. Does not necessary indicate that the dataset itself is interoperable, only that the data card includes all the metadata to support interoperability." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:DatacardCapabilities ;
            sh:maxCount 1 ;
