            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path iao:IAO_0000136 ] ;
    sh:targetClass llnl:SimulationDetails .

llnl:Software a sh:NodeShape ;
    rdfs:label "software" ;
    rdfs:comment "- name: __NAME__ version: __VERSION__ identifier: type: __TYPE__                      # doi | ark | handle | url | local | other value: __VALUE__ role: - ${ROLE}                           # [interoperability_if_applicable] list from roles extending the CRediT taxonomy: Conceptualization | Data_Curation | Formal_Analysis | Funding_Acquisition | Investigation | Methodology | Project_Administration | Resources | Software | Supervision | Validation | Visualization | Writing_Original_Draft | Writing_Review_Editing | Data_Collection | Other relationship: __REL__                 # see vocabulary above" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:RelatedResources ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class cco:ont00001261 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001808 ] ;
    sh:targetClass llnl:Software .

llnl:SourceData a sh:NodeShape ;
    rdfs:label "source_data" ;
