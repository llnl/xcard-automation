llnl:SimulationDetails a sh:NodeShape ;
    rdfs:label "simulation_details" ;
    rdfs:comment "[interoperability_if_applicable] For simulation-derived data: code, version, key parameters, and configuration. e.g., LAMMPS 23Jun2022, NVT ensemble, 300K, 10ns run, CHARMM36" ;
