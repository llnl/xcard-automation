llnl:TrainingUseStatus a sh:NodeShape ;
    rdfs:label "training_use_status" ;
    rdfs:comment "[ai_usability_required] Yes | No | Conditional" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:AiUsage ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "Yes" "No" "Conditional" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:TrainingUseStatus .

llnl:Type a sh:NodeShape ;
    rdfs:label "type" ;
    rdfs:comment "doi | ark | handle | url | local | other" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "doi" "ark" "handle" "url" "local" "other" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Contributors ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Type .

llnl:UcniStatus a sh:NodeShape ;
    rdfs:label "ucni_status" ;
    rdfs:comment "[discoverability_required] Yes | No description: Indicates whether the asset contains UCNI. UCNI is represented separately and should not be treated as an ordinary CUI category value." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:UcniStatus .

llnl:UkMdaStatus a sh:NodeShape ;
    rdfs:label "uk_mda_status" ;
    rdfs:comment "[discoverability_if_applicable] Yes | No| Unknown | not_applicable Indicates whether the asset is subject to UK Ministry of Defence Assessment (MDA) controls." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "Yes" "No" "Unknown" "Not applicable" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:UkMdaStatus .

llnl:UncertaintyNotes a sh:NodeShape ;
