    sh:targetClass llnl:StartDate .

llnl:State a sh:NodeShape ;
    rdfs:label "state" ;
    rdfs:comment "[discoverability_required] Current lifecycle position: Raw        — data as collected; no processing applied Processing — actively being cleaned, transformed, or reduced QA         — undergoing quality assurance or validation Analysis   — in active scientific analysis Review     — under formal review (security, export, IRB, etc.) Embargo    — complete but intentionally withheld from release Published  — publicly released Archived   — preserved; no longer actively maintained not_applicable - use when workflow state is not applicable or not yet determined" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Workflow ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "Raw" "Processing" "QA" "Analysis" "Embargo" "Published" "Archived" "Not-applicable" "Not Applicable" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:State .

llnl:SuccessionNote a sh:NodeShape ;
    rdfs:label "succession_note" ;
    rdfs:comment "[discoverability_if_applicable] Who to contact if this contact is no longer reachable. e.g., Contact the ORNL data management office at data@ornl.gov" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:AdditionalContacts ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
