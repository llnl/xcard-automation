llnl:ReviewProvenanceCompanion a sh:NodeShape ;
    rdfs:label "review_provenance_companion" ;
    rdfs:comment "Optional companion block for review/provenance data that the team has indicated should exist somewhere in the broader card/model. This block extends the Genesis Sensitivity V2 review_provenance_companion (which only accepts a single review) by allowing multiple review records to be captured in a structured format, which is especially useful for datasets that have undergone multiple reviews or have complex provenance histories." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
