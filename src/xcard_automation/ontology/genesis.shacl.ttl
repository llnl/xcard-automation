        [ sh:class llnl:DatacardCapabilities ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:SupportsReusability .

llnl:TaskCategory a sh:NodeShape ;
    rdfs:label "task_category" ;
    rdfs:comment "[discoverability_if_applicable, at least one value required if task_subcategory is present] Primary ML task category or categories for this dataset. Populate for AI-ready data; helps ML practitioners find relevant datasets in the catalog. e.g., classification | regression | segmentation | detection | generation | translation | summarization | ranking | anomaly_detection | clustering | reinforcement_learning | other" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:DatasetDescription ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path llnl:value ],
        [ sh:class llnl:TaskSubcategory ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001982 ] ;
    sh:targetClass llnl:TaskCategory .

llnl:TemplateVersion a sh:NodeShape ;
    rdfs:label "template_version" ;
    rdfs:comment "[discoverability_required] DO NOT MODIFY — used by parsers to apply version-specific logic" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ],
        [ sh:class llnl:Datacard ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:TemplateVersion .

llnl:Title a sh:NodeShape ;
    rdfs:label "title" ;
    rdfs:comment "[reusability_if_applicable, required if preferred_citation is included] e.g., Neutron Scattering Data from SNS Beamline 1B, April 2023" ;
