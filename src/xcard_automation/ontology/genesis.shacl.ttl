llnl:DatasetScale a sh:NodeShape ;
    rdfs:label "dataset_scale" ;
    rdfs:comment "These fields describe the scale of the dataset, which is important for users to understand the scope and potential resource requirements for using the dataset. record_count and record_unit provide a standardized way to describe the number of primary records, samples, files, or other relevant units in the dataset, which is critical for understanding the dataset's size and complexity. compressed_bytes and uncompressed_bytes provide information about the storage requirements for the dataset, which is important for users to plan" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Accessibility ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:class iao:IAO_0001000 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001808 ] ;
    sh:targetClass llnl:DatasetScale .

