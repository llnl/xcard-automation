llnl:Facilities a sh:NodeShape ;
    rdfs:label "facilities" ;
    rdfs:comment "[discoverability_if_applicable] User facilities, HPC centers, or research infrastructure used to collect, process, or store the dataset. - name: __FACILITY_NAME__               # e.g., Spallation Neutron Source | Summit | Frontier ror_id: __ROR_ID__ role: - ${ROLE}                           # [discoverability_if_applicable] list from roles extending the CRediT taxonomy: Conceptualization | Data_Curation | Formal_Analysis | Funding_Acquisition | Investigation | Methodology | Project_Administration | Resources | Software | Supervision | Validation | Visualization | Writing_Original_Draft | Writing_Review_Editing | Data_Collection | Other location:                             # [discoverability_if_applicable] Point location for facility-based experimental data. description: __DESC__               # e.g., SNS Beamline 1B, Oak Ridge National Laboratory, TN, USA ror_id: __ROR_ID__                  # ROR ID of the facility; cross-reference with name above" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Discoverability ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:Facilities .

