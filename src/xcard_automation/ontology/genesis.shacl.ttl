            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
    sh:targetClass llnl:SupersededBy .

llnl:Supersedes a sh:NodeShape ;
    rdfs:label "supersedes" ;
    rdfs:comment "[discoverability_if_applicable] Identifier of the prior version this dataset replaces. See stewardship.versioning_strategy for how versions are managed." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Identification ;
