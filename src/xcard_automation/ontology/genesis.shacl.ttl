    sh:targetClass llnl:CuiBasicCategories .

llnl:CuiLimitedDisseminationControls a sh:NodeShape ;
    rdfs:label "cui_limited_dissemination_controls" ;
    rdfs:comment "[discoverability_if_applicable] List the applicable CUI limited dissemination controls, if any. provide as a list of unique entries if multiple controls apply. e.g., - NOFORN - DL ONLY -  REL TO USA, GBR - DISPLAY ONLY USA, GBR - RELIDO If cui_limited_dissemination_controls contains NOFORN, REL TO..., DISPLAY ONLY..., or similar controls, foreign_national_access_status should be consistent with those controls." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:Sensitivity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:in ( "NOFORN" "CNWDI" "SIGMA 14" "REL TO USA, CAN, GBR" "ORCON" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path llnl:value ],
        [ sh:class cco:ont00000751 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001942 ] ;
    sh:targetClass llnl:CuiLimitedDisseminationControls .

llnl:CuiSpecifiedCategories a sh:NodeShape ;
    rdfs:label "cui_specified_categories" ;
    rdfs:comment "[discoverability_if_applicable, at least one basic or specified category is required if cui_status = Yes] For CUI, list the specified category or categories that apply, if any. use DOE/ISOO-authoritative CUI Specified categories or subcategories. provide as a list of unique entries if multiple categories apply." ;
