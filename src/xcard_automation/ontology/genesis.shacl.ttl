            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path llnl:value ],
        [ sh:class iao:IAO_0000305 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cco:ont00001916 ],
        [ sh:class llnl:PreferredCitation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ] ;
