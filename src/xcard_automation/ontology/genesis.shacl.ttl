            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:SuccessionNote .

llnl:Summary a sh:NodeShape ;
    rdfs:label "summary" ;
    rdfs:comment "[discoverability_required] Brief description of what changed and why. Update this text for all subsequent revisions. e.g., Updated license to CC-BY-4.0 e.g., Added checksum after file transfer to OSTI e.g., Corrected collection end date" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class llnl:ChangeDate ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:BFO_0000176 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path llnl:value ] ;
    sh:targetClass llnl:Summary .

llnl:SupersededBy a sh:NodeShape ;
    rdfs:label "superseded_by" ;
    rdfs:comment "[discoverability_if_applicable] Identifier of the newer version that replaces this dataset. Populate when this version is deprecated." ;
