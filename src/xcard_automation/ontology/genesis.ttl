llnl:id rdfs:label "id" ;
    bfo:BFO_0000176 llnl:datacard ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000292 ;
    skos:definition "[discoverability_if_applicable] Persistent identifier for this data card document itself, distinct from the dataset identifier. Assign if the data card is registered in a catalog or repository independently of the dataset." .

llnl:missing_data_codes rdfs:label "missing_data_codes" ;
    bfo:BFO_0000176 llnl:data_quality ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[reusability_if_applicable] - code: __CODE__                       # e.g., -999 | NaN | NULL description: __DESC__                # e.g., Sensor malfunction | Below detection limit" .

llnl:parent_collection rdfs:label "parent_collection" ;
    bfo:BFO_0000176 llnl:identification ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[discoverability_if_applicable] Parent collection or experimental campaign this dataset belongs to. Use when this dataset is one of many in a larger organized collection or ensemble." ;
    cco:ont00001808 iao:IAO_0001000 .

