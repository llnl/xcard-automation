@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix llnl: <http://example.org/llnl#> .
@prefix obi: <http://purl.obolibrary.org/obo/OBI_> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pato: <http://purl.obolibrary.org/obo/PATO_> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

llnl:access_level rdfs:label "access_level" ;
    bfo:BFO_0000176 llnl:access_policy,
        llnl:name ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:definition "[accessibility_required] Open | Restricted | Controlled" .

llnl:access_protocol rdfs:label "access_protocol" ;
    bfo:BFO_0000176 llnl:name ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[reference_only_do_not_include] https | ftp | s3 | globus | nfs | lustre | other" ;
    cco:ont00001982 llnl:repositories .

llnl:access_restrictions rdfs:label "access_restrictions" ;
    bfo:BFO_0000176 llnl:access_policy ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[accessibility_if_applicable] Freetext description of access restrictions. e.g., Requires signed DUA | None - publicly accessible" .

llnl:accessed_date rdfs:label "accessed_date" ;
    bfo:BFO_0000176 llnl:ai_model ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:date ],
        cco:ont00000529 ;
    skos:definition "Date when AI model was accessed" .

llnl:agent_type rdfs:label "agent_type" ;
    bfo:BFO_0000176 llnl:additional_contacts,
        llnl:contact,
        llnl:creator ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00001017 ;
    skos:definition "[discoverability_required] person | organization | ai_model | software TYPE: person — use for a human contributor" .

llnl:agreement_required rdfs:label "agreement_required" ;
    bfo:BFO_0000176 llnl:rights_release_records ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:definition "[governed_use_required] select one from list: Yes | No — Is a rights release agreement required for use of this dataset?" .

llnl:agreement_type rdfs:label "agreement_type" ;
    bfo:BFO_0000176 llnl:rights_release_records ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:definition "[governed_use_if_applicable, required if agreement_required = Yes] list all that apply: DUA | CRADA | MOU | NDA | LICENSE | WFO | OTHER" .

llnl:ai_models rdfs:label "ai_models" ;
    bfo:BFO_0000176 llnl:related_resources ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "- name: __NAME__ version: __VERSION__ accessed_date: __YYYY-MM-DD__ identifier: type: __TYPE__                      # doi | ark | handle | url | local | other value: __VALUE__ role: - ${ROLE}                           # [interoperability_if_applicable] list from roles extending the CRediT taxonomy: Conceptualization | Data_Curation | Formal_Analysis | Funding_Acquisition | Investigation | Methodology | Project_Administration | Resources | Software | Supervision | Validation | Visualization | Writing_Original_Draft | Writing_Review_Editing | Data_Collection | Other relationship: __REL__                 # see vocabulary above" ;
    cco:ont00001982 cco:ont00000653 .

llnl:approved_environments rdfs:label "approved_environments" ;
    bfo:BFO_0000176 llnl:access_policy ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[accessibility_if_applicable] Describe the approved environment for access. List of approved environments, if more than one — e.g., DOE HPC facilities with export control review | On-site access only at Oak Ridge National Laboratory [] means no explicitly approved environments; access may still be granted on a case-by-case basis. null or absent means it has not yet been determined whether approved environments are required." .

llnl:authentication rdfs:label "authentication" ;
    bfo:BFO_0000176 llnl:name ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:definition "None | API_Key | OAuth2 | SAML | Certificate | OpenID_Connect | Basic_Auth | Bearer_Token | Other" ;
    cco:ont00001808 llnl:intended_repositories .

llnl:author rdfs:label "author" ;
    bfo:BFO_0000176 llnl:preferred_citation ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[reusability_if_applicable, required if preferred_citation is included] e.g., Smith, John A.; Doe, Jane B." .

llnl:authorization_required rdfs:label "authorization_required" ;
    bfo:BFO_0000176 llnl:access_policy ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:definition "[accessibility_if_applicable] Required if access_level is not open. List of authorization needed to access this dataset: Account               — registered account required User_Agreement        — user agreement or terms of service Data_Use_Agreement    — formal DUA required Sponsor_Approval      — sponsor or PI approval required Export_Control_Review — export control review required IRB_Approval          — IRB approval required Other                 — describe in access_restrictions" .

llnl:award_number rdfs:label "award_number" ;
    bfo:BFO_0000176 llnl:name ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:token ],
        cco:ont00000292 ;
    skos:definition "[discoverability_if_applicable] e.g., DE-AC05-00OR22725" .

llnl:bias_risks rdfs:label "bias_risks" ;
    bfo:BFO_0000176 llnl:ai_usage ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[ai_usability_required] e.g., Overrepresents samples from facility X | None" .

llnl:checksum_available rdfs:label "checksum_available" ;
    bfo:BFO_0000176 llnl:integrity ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[reusability_if_applicable] Yes | No" .

llnl:checksum_type rdfs:label "checksum_type" ;
    bfo:BFO_0000176 llnl:integrity ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[required if checksum_available=Yes] sha256 | sha512 | md5 | other sha256 recommended; md5 not recommended for new datasets" .

llnl:checksum_value rdfs:label "checksum_value" ;
    bfo:BFO_0000176 llnl:integrity ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:anyURI ],
        cco:ont00000853 ;
    skos:definition "[required if checksum_available=Yes] Checksum of primary data file(s). For multi-file datasets, provide a checksum manifest and link here." .

llnl:citation rdfs:label "citation" ;
    bfo:BFO_0000176 llnl:reusability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[reusability_if_applicable] Important:Populate when dataset release_status = Approved | Published. Replace ALL ${...} placeholders in the BibTeX block below before publishing." ;
    cco:ont00001982 iao:IAO_0000301 .

llnl:citation_count rdfs:label "citation_count" ;
    bfo:BFO_0000176 llnl:usage_metrics ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:integer ],
        cco:ont00001163 ;
    skos:definition "Field for citation counts" ;
    cco:ont00001808 iao:IAO_0000301 .

llnl:classification_category rdfs:label "classification_category" ;
    bfo:BFO_0000176 llnl:sensitivity ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "[discoverability_if_applicable] For classified information, list the classification category or categories, if applicable. use vocabulary: NSI | RD | FRD | TFNI | Other_Classified" ;
    cco:ont00001942 cco:ont00000751 .

llnl:classification_level rdfs:label "classification_level" ;
    bfo:BFO_0000176 llnl:sensitivity ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "[discoverability_if_applicable] For classified information, top_secret | secret | confidential classification level" ;
    cco:ont00001942 cco:ont00000751 .

llnl:classified_control_markings rdfs:label "classified_control_markings" ;
    bfo:BFO_0000176 llnl:sensitivity ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "[discoverability_if_applicable] For classified information, list the specific control markings that apply, if any. Provide as a list of unique entries if multiple markings apply. e.g., - NOFORN - CNWDI - SIGMA 14 - REL TO USA, CAN, GBR - ORCON" ;
    cco:ont00001942 cco:ont00000751 .

llnl:classified_status rdfs:label "classified_status" ;
    bfo:BFO_0000176 llnl:sensitivity ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "[discoverability_required] Yes | No description: Indicates whether the asset is classified." ;
    cco:ont00001942 cco:ont00000751 .

llnl:code rdfs:label "code" ;
    bfo:BFO_0000176 llnl:missing_data_codes ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:token ],
        cco:ont00000853 ;
    skos:definition "code for missing data" ;
    cco:ont00001982 cco:ont00000077 .

llnl:collection_methodology rdfs:label "collection_methodology" ;
    bfo:BFO_0000176 llnl:dataset_description ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[discoverability_if_applicable] How was data acquired? e.g., experimental sensors | computational simulation | human annotation | derived from prior datasets" ;
    cco:ont00001808 iao:IAO_0001000 .

llnl:comments rdfs:label "comments" ;
    bfo:BFO_0000176 llnl:source_review_reference ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[governed_use_if_applicable]" .

llnl:compiler rdfs:label "compiler" ;
    bfo:BFO_0000176 llnl:software_environment ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[interoperability_if_applicable] e.g., GCC 11.3 | Intel oneAPI 2023.1" ;
    cco:ont00001808 cco:ont00000932 .

llnl:completeness rdfs:label "completeness" ;
    bfo:BFO_0000176 llnl:data_quality ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[reusability_required] e.g., All detector channels present; 2% of timesteps missing due to instrument downtime on 2023-04-12" ;
    cco:ont00001982 cco:ont00000575 .

llnl:completeness_score rdfs:label "completeness_score" ;
    bfo:BFO_0000176 llnl:_repository ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:decimal ],
        cco:ont00000853 ;
    skos:definition "[reference_only_do_not_include] Catalog-computed completeness score against completeness of fields in declared inteded_capabilities" .

llnl:compressed_bytes rdfs:label "compressed_bytes" ;
    bfo:BFO_0000176 llnl:dataset_scale ;
    qudt:hasUnit unit:BYTE ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:integer ],
        cco:ont00001163 ;
    skos:definition "[accessibility_if_applicable] Total size when compressed, in bytes" .

llnl:container rdfs:label "container" ;
    bfo:BFO_0000176 llnl:software_environment ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:anyURI ],
        cco:ont00000649 ;
    skos:definition "[interoperability_if_applicable] e.g., docker://registry/image:tag" ;
    cco:ont00001808 cco:ont00000420 .

llnl:created_date rdfs:label "created_date" ;
    bfo:BFO_0000176 llnl:datacard ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:date ],
        cco:ont00000529 ;
    skos:definition "[discoverability_required] ISO 8601 date this data card was first created" .

llnl:creation_method rdfs:label "creation_method" ;
    bfo:BFO_0000176 llnl:datacard ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[discoverability_required] Method used to create or most recently update this data card. " .

llnl:cui_basic_categories rdfs:label "cui_basic_categories" ;
    bfo:BFO_0000176 llnl:sensitivity ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[discoverability_if_applicable, at least one basic or specified category is required if cui_status = Yes] For CUI, list the basic category or categories that apply, if any. use DOE/ISOO-authoritative CUI Basic categories or subcategories. provide as a list of unique entries if multiple categories apply." ;
    cco:ont00001982 cco:ont00000751 .

llnl:cui_limited_dissemination_controls rdfs:label "cui_limited_dissemination_controls" ;
    bfo:BFO_0000176 llnl:sensitivity ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "[discoverability_if_applicable] List the applicable CUI limited dissemination controls, if any. provide as a list of unique entries if multiple controls apply. e.g., - NOFORN - DL ONLY -  REL TO USA, GBR - DISPLAY ONLY USA, GBR - RELIDO If cui_limited_dissemination_controls contains NOFORN, REL TO..., DISPLAY ONLY..., or similar controls, foreign_national_access_status should be consistent with those controls." ;
    cco:ont00001942 cco:ont00000751 .

llnl:cui_specified_categories rdfs:label "cui_specified_categories" ;
    bfo:BFO_0000176 llnl:sensitivity ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[discoverability_if_applicable, at least one basic or specified category is required if cui_status = Yes] For CUI, list the specified category or categories that apply, if any. use DOE/ISOO-authoritative CUI Specified categories or subcategories. provide as a list of unique entries if multiple categories apply." ;
    cco:ont00001982 cco:ont00000751 .

llnl:cui_status rdfs:label "cui_status" ;
    bfo:BFO_0000176 llnl:sensitivity ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "[discoverability_required] Yes | No description: Indicates whether the asset is CUI." ;
    cco:ont00001942 cco:ont00000751 .

llnl:current_location rdfs:label "current_location" ;
    bfo:BFO_0000176 llnl:access ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:anyURI ],
        cco:ont00000649 ;
    skos:definition "[accessibility_required] Where the data physically resides right now. Use for in-workflow data not yet deposited in a repository, or for any dataset with a known internal or external storage path. e.g., /mnt/ecs/scientific-data/project/dataset/ e.g., /lustre/orion/proj-shared/dataset/ e.g., s3://genesis-bucket/dataset/" .

llnl:current_use rdfs:label "current_use" ;
    bfo:BFO_0000176 llnl:use_governance ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[governed_use_required] For in-workflow data: what is this dataset actively being used for right now? Distinct from intended_use." .

llnl:data_characteristics rdfs:label "data_characteristics" ;
    bfo:BFO_0000176 llnl:dataset_description ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[discoverability_if_applicable] Key structural and content characteristics: scale, dimensionality, temporal coverage, spatial resolution" .

llnl:data_collection_end rdfs:label "data_collection_end" ;
    bfo:BFO_0000176 llnl:dates ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:date ],
        cco:ont00000529 ;
    skos:definition "[interoperability_if_applicable] ISO 8601 date data collection or generation ended" .

llnl:data_collection_start rdfs:label "data_collection_start" ;
    bfo:BFO_0000176 llnl:dates ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:date ],
        cco:ont00000529 ;
    skos:definition "[interoperability_if_applicable] ISO 8601 date data collection or generation began" .

llnl:data_type rdfs:label "data_type" ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:definition "[interoperability_if_applicable] The data type of the value (e.g., string, integer, float, boolean)." ;
    cco:ont00001920 llnl:FIELD_NAME .

llnl:datacard_version rdfs:label "datacard_version" ;
    bfo:BFO_0000176 llnl:datacard ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000649 ;
    skos:definition "[discoverability_required] Version of this specific data card document. Increment when the data card is meaningfully updated. Use semantic versioning: MAJOR.MINOR.PATCH e.g., 1.0 → 1.1 for content updates; 1.x → 2.0 for structural changes" .

llnl:dataset_download_url rdfs:label "dataset_download_url" ;
    bfo:BFO_0000176 llnl:name ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:anyURI ],
        cco:ont00000649 ;
    skos:definition "[reference_only_do_not_include] Direct download URL assigned by the repository" ;
    cco:ont00001808 llnl:repositories .

llnl:dataset_id_in_repo rdfs:label "dataset_id_in_repo" ;
    bfo:BFO_0000176 llnl:name ;
    rdfs:subClassOf cco:ont00000649 ;
    skos:definition "[reference_only_do_not_include] Accession number or ID assigned by this repository" ;
    cco:ont00001808 llnl:repositories .

llnl:dataset_landing_page rdfs:label "dataset_landing_page" ;
    bfo:BFO_0000176 llnl:name ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[reference_only_do_not_include] Human-readable dataset page assigned by the repository" ;
    cco:ont00001982 llnl:repositories .

llnl:dataset_summary rdfs:label "dataset_summary" ;
    bfo:BFO_0000176 llnl:dataset_description ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        iao:IAO_0000315 ;
    skos:definition "[discoverability_required] 1–3 sentence plain-language description of the dataset. Write for a broad scientific audience unfamiliar with your project." .

llnl:dataset_type rdfs:label "dataset_type" ;
    bfo:BFO_0000176 llnl:discoverability ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000686 ;
    skos:definition "[discoverability_if_applicable] OSTI DOE Data Explorer type code. Select the single best-fit: GD  Genome/Genetic Data     — DNA/RNA sequences, genomic annotations IM  Image                   — photographs, scans, microscopy, visualizations ND  Numeric Data            — measurements, time series, tabular, sensor readings SM  Specialized Mix         — multiple data types combined FP  Figure/Plot             — charts, graphs, plots as primary deliverable I   Interactive Resource    — web apps, interactive visualizations, dashboards MM  Multimedia              — audio, video, combined media MD  Model                   — computational models, simulations, trained ML models AS  Automated Software      — scripts, analysis pipelines, workflows IP  Instrumentation/Protocols — experimental protocols, instrument specs IG  Integrated Genomic Resources — combined genomic databases and tools" .

llnl:date_deposited rdfs:label "date_deposited" ;
    bfo:BFO_0000176 llnl:name ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:date ],
        cco:ont00000529 ;
    skos:definition "[accessibility_if_applicable]" ;
    cco:ont00001808 llnl:intended_repositories .

llnl:decontrol_or_declassify_on rdfs:label "decontrol_or_declassify_on" ;
    bfo:BFO_0000176 llnl:source_review_reference ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:date ],
        cco:ont00000529 ;
    skos:definition "[governed_use_if_applicable] If provided, use YYYY-MM-DD format or not_applicable, for export-controlled or classified datasets, the date when the dataset will be decontrolled or declassified, if known." .

llnl:description rdfs:label "description" ;
    bfo:BFO_0000176 llnl:FIELD_NAME,
        llnl:Location,
        llnl:contribution_date,
        llnl:missing_data_codes,
        llnl:name,
        llnl:spatial_coverage,
        llnl:temporal_coverage ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[discoverability_if_applicable] Describe what this contributor did. e.g., Automated generation of data card from dataset metadata e.g., Reviewed and corrected AI-generated content" .

llnl:distributions rdfs:label "distributions" ;
    bfo:BFO_0000176 llnl:_repository ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[reference_only_do_not_include] Distribution records populated at ingest" .

llnl:documentation_url rdfs:label "documentation_url" ;
    bfo:BFO_0000176 llnl:name ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:anyURI ],
        cco:ont00000649 ;
    skos:definition "URL to locate the documentation" ;
    cco:ont00001808 llnl:data_services .

llnl:doe_data_management_plan rdfs:label "doe_data_management_plan" ;
    bfo:BFO_0000176 llnl:compliance ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:definition "[governed_use_required] select one from list: Yes | No | Unknown — a DOE DMP is on file for this dataset" .

llnl:doi rdfs:label "doi" ;
    bfo:BFO_0000176 llnl:preferred_citation ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:anyURI ],
        cco:ont00000649 ;
    skos:definition "[reusability_if_applicable, either doi or url is required] e.g., 10.1234/zenodo.1234567" .

llnl:download_count rdfs:label "download_count" ;
    bfo:BFO_0000176 llnl:usage_metrics ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:integer ],
        cco:ont00001163 ;
    skos:definition "field for download counts" .

llnl:eastBoundLongitude rdfs:label "eastBoundLongitude" ;
    bfo:BFO_0000176 llnl:geo_location_box ;
    qudt:hasUnit unit:DEG ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:decimal ],
        cco:ont00001163 ;
    skos:definition "aligns with datacite:eastBoundLongitude" ;
    cco:ont00001808 cco:ont00000469 .

llnl:email rdfs:label "email" ;
    bfo:BFO_0000176 llnl:Person ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00002070 ;
    skos:definition "${EMAIL}" .

llnl:embargo_until rdfs:label "embargo_until" ;
    bfo:BFO_0000176 llnl:workflow ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:date ],
        cco:ont00000529 ;
    skos:definition "[discoverability_if_applicable] Required if state=embargo. ISO 8601 date after which release is permitted." .

llnl:encoding rdfs:label "encoding" ;
    bfo:BFO_0000176 llnl:data_structure ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[interoperability_if_applicable] Character encoding for text-based formats. e.g., UTF-8 | ASCII | Latin-1 UTF-8 strongly recommended. Use not_applicable for binary formats." .

