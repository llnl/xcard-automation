    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[discoverability_if_applicable] Identifier of the newer version that replaces this dataset. Populate when this version is deprecated." .

llnl:supersedes rdfs:label "supersedes" ;
    bfo:BFO_0000176 llnl:identification ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[discoverability_if_applicable] Identifier of the prior version this dataset replaces. See stewardship.versioning_strategy for how versions are managed." .

llnl:access rdfs:label "access" ;
    bfo:BFO_0000176 llnl:accessibility ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Complete the fields you know at the time of data card creation. Repository-assigned fields (landing pages, accession numbers, access protocols) will be populated by the managing repository or catalog system at ingest — see the REPOSITORY-MANAGED block." .

llnl:accessibility rdfs:label "accessibility" ;
    bfo:BFO_0000101 llnl:genesis_datacard_merged_shared ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[accessibility_required] --- Access Policy ---------------------------------------------- Describes who can access this dataset and under what conditions. Access policy for the dataset. Describes the access level and any restrictions or requirements for accessing the dataset, which is critical information for users to understand how they can access the dataset and any potential barriers to access. Access policy is DISTINCT from sensitivity, which describes the nature of the data and its potential risks) and from release status (which describes the publication state of the dataset). access_policy.access_level is a required field that indicates the level of permissions required for users to access the dataset, following AccessLevelEnum. - open: no additional permissions required beyond standard account registration and agreement to terms of service. This indicates that the dataset is freely accessible to the public and can be used without any special permissions or restrictions. Note that open does not necessarily mean that the dataset is free of copyright or other legal restrictions, but rather that there are no additional access controls in place. Users may still need to comply with any applicable laws or regulations when using the dataset. - restricted: access may be granted to users who meet certain criteria, such as being part of a specific research community, having a legitimate research purpose, or agreeing to specific terms and conditions. This indicates that the dataset is not freely accessible to the public and that users must meet certain requirements or restrictions in order to access it. The specific criteria for access may vary depending on the dataset and the organization providing it, but could include things like institutional affiliation, research purpose, or agreement to specific terms and conditions. - controlled: access is tightly controlled and may require specific authorization, agreements, or approvals. This indicates that the dataset contains sensitive information and that only authorized users can access it." .

llnl:compliance rdfs:label "compliance" ;
    bfo:BFO_0000176 llnl:governed_use ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Leave blank or omit for draft and in-workflow datasets." .

llnl:contributors rdfs:label "contributors" ;
    bfo:BFO_0000176 llnl:discoverability ;
    rdfs:subClassOf cco:ont00000300 ;
    skos:definition "[discoverability_if_applicable] Supporting contributors who are not primary authors. e.g., sample preparers, annotators, reviewers, submitters. Same structure as authors above." .

llnl:export_control rdfs:label "export_control" ;
    bfo:BFO_0000176 llnl:non_sensitivity_governance_metadata ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Export Control & Foreign National Access" .

llnl:maintainer rdfs:label "maintainer" ;
    bfo:BFO_0000176 llnl:stewardship ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[reusability_if_applicable] Person or organization responsible for ongoing maintenance." ;
    cco:ont00001982 cco:ont00001017 .

llnl:non_sensitivity_governance_metadata rdfs:label "non_sensitivity_governance_metadata" ;
    bfo:BFO_0000176 llnl:governed_use ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[governed_use_required] export control, privacy, right & release as it applies to the dataset as a whole, which may be distinct from the sensitivity or classification of the source data from which it was derived. Export Control & Foreign National Access." .

llnl:reviewed_by rdfs:label "reviewed_by" ;
    bfo:BFO_0000176 llnl:source_review_reference ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[governed_use_if_applicable] Delete the block that does not apply." .

llnl:tags rdfs:label "tags" ;
    bfo:BFO_0000176 llnl:dataset_description ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[discoverability_if_applicable] Structured tags for catalog filtering and discovery." .

llnl:temporal_coverage rdfs:label "temporal_coverage" ;
    bfo:BFO_0000176 llnl:data_structure ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[interoperability_if_applicable] Time period the dataset content represents. aligns with schema:temporalCoverage NOTE: distinct from dates.data_collection_start/end, which describe when collection occurred. Use temporal_coverage when the dataset describes a specific historical or projected time period that differs from when collection happened. e.g., Monthly climate averages 1950–2020 collected in 2024: temporal_coverage.start = 1950-01-01 dates.data_collection_start = 2024-01-01" .

llnl:type rdfs:label "type" ;
    bfo:BFO_0000176 llnl:Identifier,
        llnl:additional_ids,
        llnl:authors,
        llnl:contributors,
        llnl:datacard_checksum,
        llnl:id,
        llnl:maintainer,
        llnl:primary_id,
        llnl:reviewed_by,
        llnl:schema_reference,
        llnl:superseded_by,
        llnl:supersedes ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "doi | ark | handle | url | local | other" .

llnl:FIELD_NAME rdfs:label "FIELD_NAME" ;
    bfo:BFO_0000101 llnl:genesis_datacard_merged_shared ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "${FIELD_NAME} [interoperability_if_applicable] The name of the domain-specific metadata field." .

llnl:additional_contacts rdfs:label "additional_contacts" ;
    bfo:BFO_0000176 llnl:discoverability ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00001017 ;
    skos:definition "[discoverability_if_applicable] Additional contacts (e.g., instrument PI, data steward). Same structure as contact above: contact_details: - type: person | organization person: given_name: __GIVEN_NAME__ family_name: __FAMILY_NAME__ orcid: __ORCID__ # Required where DOE employee/contractor author policy applies, if locally applicable email: __EMAIL__ affiliation: name: __ORG_NAME__ ror_id: __ROR_ID__ valid_until: __YYYY-MM-DD__ succession_note: __NOTE__" .

llnl:additional_licenses rdfs:label "additional_licenses" ;
    bfo:BFO_0000176 llnl:reusability ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[reusability_if_applicable] List of additional licenses that apply to subsets of the dataset, if any. e.g., if a dataset contains third-party data with different licensing terms, those can be captured here. Each entry should include the same fields as the main license block above, along with a description of which subset of the data it applies to." .

llnl:contact rdfs:label "contact" ;
    bfo:BFO_0000176 llnl:discoverability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[discoverability_required] Primary point of contact for questions about this DATASET." .

llnl:dataset_scale rdfs:label "dataset_scale" ;
    bfo:BFO_0000176 llnl:accessibility ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "These fields describe the scale of the dataset, which is important for users to understand the scope and potential resource requirements for using the dataset. record_count and record_unit provide a standardized way to describe the number of primary records, samples, files, or other relevant units in the dataset, which is critical for understanding the dataset's size and complexity. compressed_bytes and uncompressed_bytes provide information about the storage requirements for the dataset, which is important for users to plan" ;
    cco:ont00001808 iao:IAO_0001000 .

llnl:dates rdfs:label "dates" ;
    bfo:BFO_0000176 llnl:interoperability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "field regarding data collection dates" .

llnl:facilities rdfs:label "facilities" ;
    bfo:BFO_0000176 llnl:discoverability ;
    rdfs:subClassOf cco:ont00000946 ;
    skos:definition "[discoverability_if_applicable] User facilities, HPC centers, or research infrastructure used to collect, process, or store the dataset. - name: __FACILITY_NAME__               # e.g., Spallation Neutron Source | Summit | Frontier ror_id: __ROR_ID__ role: - ${ROLE}                           # [discoverability_if_applicable] list from roles extending the CRediT taxonomy: Conceptualization | Data_Curation | Formal_Analysis | Funding_Acquisition | Investigation | Methodology | Project_Administration | Resources | Software | Supervision | Validation | Visualization | Writing_Original_Draft | Writing_Review_Editing | Data_Collection | Other location:                             # [discoverability_if_applicable] Point location for facility-based experimental data. description: __DESC__               # e.g., SNS Beamline 1B, Oak Ridge National Laboratory, TN, USA ror_id: __ROR_ID__                  # ROR ID of the facility; cross-reference with name above" .

llnl:geo_location_box rdfs:label "geo_location_box" ;
    bfo:BFO_0000176 llnl:spatial_coverage ;
    rdfs:subClassOf cco:ont00000358 ;
    skos:definition "[interoperability_if_applicable] WGS84 decimal degrees; use for area coverage aligns with datacite:geoLocationBox" .

llnl:governed_use rdfs:label "governed_use" ;
    bfo:BFO_0000176 llnl:genesis_datacard_merged_shared ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[governed_use_required] For datasets that are actively being used in workflows, or where use governance is needed to manage risks, ensure responsible use, or enable discoverability for specific use cases. Populate the fields that are relevant to the dataset's current, intended, permitted, out_of_scope, and prohibited use. current_use is required for governed_use_required; the other fields are optional but recommended to support responsible use and discoverability." .

llnl:integrity rdfs:label "integrity" ;
    bfo:BFO_0000178 llnl:reusability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Checksums enable automated validation of data integrity after transfer or storage." .

llnl:license rdfs:label "license" ;
    bfo:BFO_0000176 llnl:reusability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A public/open license is not always the governing instrument for use, some controlled datasets may not have an SPDX-style reuse license at all, and use may instead be governed by contract, agreement, institutional review, or repository policy." ;
    cco:ont00001982 terms:LicenseDocument .

llnl:related_resources rdfs:label "related_resources" ;
    bfo:BFO_0000176 llnl:interoperability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Links to related datasets, publications, software, and AI models. The base relationship vocabulary isshared across all resource types; extended terms are available for software and AI models." ;
    cco:ont00001982 cco:ont00000740 .

llnl:usage_metrics rdfs:label "usage_metrics" ;
    bfo:BFO_0000176 llnl:_repository ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[reference_only_do_not_include] Populated by the managing repository; do not edit" .

llnl:workflow rdfs:label "workflow" ;
    bfo:BFO_0000176 llnl:discoverability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Describes the technical and processing lifecycle position of the dataset. See NOTE ON WORKFLOW STATE vs. RELEASE STATUS in the header for expected alignment with release_status." ;
    cco:ont00001808 llnl:PMD_0000012 .

llnl:ai_model rdfs:label "ai_model" ;
    bfo:BFO_0000176 llnl:creator ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "use when an AI model generated or substantially contributed to this data card" ;
    cco:ont00001808 cco:ont00001261 .

llnl:creator rdfs:label "creator" ;
    bfo:BFO_0000176 llnl:contribution_date ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[discoverability_required] person | organization | ai_model | software add one block per creator; list the block that corresponds to the parent {ROLE} contributed to the creation of this data card Delete the three blocks below that do not apply." .

llnl:privacy rdfs:label "privacy" ;
    bfo:BFO_0000176 llnl:non_sensitivity_governance_metadata ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Privacy & Human Subjects" .

llnl:repositories rdfs:label "repositories" ;
    bfo:BFO_0000176 llnl:_repository ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[reference_only_do_not_include] Resolved repository records keyed to access.intended_repositories" .

llnl:rights_release_records rdfs:label "rights_release_records" ;
    bfo:BFO_0000176 llnl:non_sensitivity_governance_metadata ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Rights & Agreements" ;
    cco:ont00001982 terms:LicenseDocument .

llnl:software_environment rdfs:label "software_environment" ;
    bfo:BFO_0000176 llnl:provenance ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[interoperability_if_applicable] Software environment used to generate or process this dataset. Captures what is needed for computational reproducibility." .

llnl:stewardship rdfs:label "stewardship" ;
    bfo:BFO_0000176 llnl:reusability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[reusability_if_applicable] Information about the stewardship of this dataset, including who is responsible for maintaining it and how versioning is managed over time." .

llnl:data_quality rdfs:label "data_quality" ;
    bfo:BFO_0000176 llnl:reusability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "vague entries reduce trust and reuse." .

llnl:datacard_capabilities rdfs:label "datacard_capabilities" ;
    bfo:BFO_0000101 llnl:genesis_datacard_merged_shared ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Describes the intended capabilities to be enabled for this data card, to guide authors, ensure completeness, and inform parsers." .

llnl:intended_repositories rdfs:label "intended_repositories" ;
    bfo:BFO_0000176 llnl:access ;
    rdfs:subClassOf cco:ont00000292 ;
    skos:definition "[accessibility_if_applicable] Repositories you intend to deposit or have deposited this dataset in. The managing repository or catalog system will resolve and populate repository-assigned fields at ingest (see REPOSITORY-MANAGED block). Repositories may be institutional, project-owned, community, or national (e.g., OSTI, Zenodo, institutional data repository, project data store)." ;
    cco:ont00001808 iao:APOLLO_SV_00000522 .

llnl:interoperability rdfs:label "interoperability" ;
    bfo:BFO_0000101 llnl:genesis_datacard_merged_shared ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Metadata elements that describe the interoperability of this dataset, such as context of data collection, data structure, provenance, related resource, schema, and integrity. This is important for users to understand how they can use the dataset and what tools or software they may need to work with it." .

llnl:provenance rdfs:label "provenance" ;
    bfo:BFO_0000176 llnl:interoperability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "provenance information" .

llnl:reusability rdfs:label "reusability" ;
    bfo:BFO_0000101 llnl:genesis_datacard_merged_shared ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[reusability_required] Information about the reusability of this dataset, such as license and rights, stewardship, data_quality, integrity, citation and stewardship information. --- License & Rights ---------------------------------------------------- [reusability_if_applicable] Important: Required when release_status = Approved | Published. Use pending if not yet assigned. Includes information about the license governing use of the dataset, as well as any additional legal rights statements. NOTE ON LICENSES AND GOVERNANCE: A public/open license is not always the governing instrument for use, some controlled datasets may not have an SPDX-style reuse license at all, and use may instead be governed by contract, agreement, institutional review, or repository policy." .

llnl:use_governance rdfs:label "use_governance" ;
    bfo:BFO_0000176 llnl:governed_use ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[governed_use_required]" .

llnl:access_policy rdfs:label "access_policy" ;
    bfo:BFO_0000176 llnl:accessibility ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[accessibility_required]" .

llnl:identification rdfs:label "identification" ;
    bfo:BFO_0000176 llnl:discoverability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[discoverability_required] Key metadata fields that uniquely identify this dataset." ;
    cco:ont00001808 cco:ont00001261 .

llnl:source_review_reference rdfs:label "source_review_reference" ;
    bfo:BFO_0000176 llnl:review_provenance_companion ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[governed_use_if_applicable] e.g., internal_qa | security | export_control | irb | partner | publication | other" .

llnl:_repository rdfs:label "_repository" ;
    bfo:BFO_0000101 llnl:genesis_datacard_merged_shared ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[reference_only_do_not_include] Repository-managed metadata fields. Do not edit manually, nor include in completed data card." .

llnl:data_structure rdfs:label "data_structure" ;
    bfo:BFO_0000176 llnl:interoperability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[interoperability_required]" ;
    cco:ont00001808 iao:IAO_0001000 .

llnl:genesis_datacard_merged_shared rdfs:label "genesis_datacard_merged_shared" ;
    rdfs:subClassOf cco:ont00000253 ;
    skos:definition "<INSTRUCTIONS: Considerations for filling out the data card: Deciding the appropriate resolution for documenting a scientific dataset in a data card can be complex. Data cards may describe single or multiple data files, datasets, or versions. Too granular, and there will be too many data cards; too broad, and details may be lost. Consider the use, audience, and documentation the data card needs to provide to maintain transparency without duplication. Reflect on these relationships to balance clarity, usability, and sustainability.>" .

llnl:ai_usage rdfs:label "ai_usage" ;
    bfo:BFO_0000176 llnl:ai_usability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "field for ai usage" .

llnl:dataset_description rdfs:label "dataset_description" ;
    bfo:BFO_0000176 llnl:discoverability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[discoverability_required] Descriptive metadata about the dataset to support discovery, understanding, and reuse." ;
    cco:ont00001808 iao:IAO_0000027 .

llnl:preferred_citation rdfs:label "preferred_citation" ;
    bfo:BFO_0000176 qudt:Citation ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[reusability_if_applicable]" ;
    cco:ont00001808 iao:IAO_0000301 .

llnl:datacard rdfs:label "datacard" ;
    bfo:BFO_0000176 llnl:discoverability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Describes this document itself — not the dataset." .

llnl:sensitivity rdfs:label "sensitivity" ;
    bfo:BFO_0000176 llnl:datacard,
        llnl:discoverability ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Sensitivity of the DATA CARD itself, which may differ from the sensitivity of the dataset it describes. Populate based on the sensitivity of the data card content alone, not the dataset. See NOTE ON SENSITIVITY above." .

llnl:discoverability rdfs:label "discoverability" ;
    bfo:BFO_0000101 llnl:genesis_datacard_merged_shared ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "DATA CARD METADATA Describes this document itself — not the dataset." .

llnl:name rdfs:label "name" ;
    bfo:BFO_0000176 llnl:Organization,
        llnl:Software,
        llnl:additional_licenses,
        llnl:affiliation,
        llnl:ai_model,
        llnl:data_services,
        llnl:dataset_publisher,
        llnl:datasets,
        llnl:domain_metadata,
        llnl:facilities,
        llnl:identification,
        llnl:intended_repositories,
        llnl:license,
        llnl:parent_collection,
        llnl:repositories,
        llnl:research_organizations,
        llnl:source_data,
        llnl:sponsor_organizations ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000686 ;
    skos:definition "e.g., Claude 3.5 Sonnet | GPT-4o | Llama 3" .

llnl:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    bfo:BFO_0000176 llnl:Identifier,
        llnl:datacard_checksum,
        llnl:id,
        llnl:primary_id,
        llnl:schema_reference,
        llnl:superseded_by,
        llnl:supersedes,
        llnl:type ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "Link to model card or documentation if available" .

