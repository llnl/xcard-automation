llnl:research_organizations rdfs:label "research_organizations" ;
    bfo:BFO_0000176 llnl:discoverability ;
    rdfs:subClassOf cco:ont00001180 ;
    skos:definition "[discoverability_required] Organizations that created or collected the data." .

llnl:review_provenance_companion rdfs:label "review_provenance_companion" ;
    bfo:BFO_0000176 llnl:governed_use ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "Optional companion block for review/provenance data that the team has indicated should exist somewhere in the broader card/model. This block extends the Genesis Sensitivity V2 review_provenance_companion (which only accepts a single review) by allowing multiple review records to be captured in a structured format, which is especially useful for datasets that have undergone multiple reviews or have complex provenance histories." .

llnl:source_data rdfs:label "source_data" ;
    bfo:BFO_0000176 llnl:provenance ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "[interoperability_if_applicable] Source datasets this dataset was derived from." .

llnl:task_subcategory rdfs:label "task_subcategory" ;
    bfo:BFO_0000176 llnl:dataset_description ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty llnl:value ;
            owl:someValuesFrom xsd:string ],
        cco:ont00000853 ;
    skos:definition "[discoverability_if_applicable] More specific ML task subcategory or subcategories. e.g., binary_classification | multi_class_classification | multi_label_classification | image_segmentation | object_detection | time_series_forecasting | named_entity_recognition | question_answering | other" .

llnl:affiliation rdfs:label "affiliation" ;
    bfo:BFO_0000176 llnl:Person ;
    rdfs:subClassOf cco:ont00000853 ;
